# Database (PostgreSQL for production, SQLite for local development)
DATABASE_URL="file:./dev.db"
# For production: DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Arc Network (settlement chain for USDC payments)
# The app defaults to Arc Mainnet; users can switch to Arc Testnet from the header.
# Both RPCs are optional - Arc's public RPCs are used if unset (uncomment to use your own).
# Source: https://docs.arc.io/arc/references/connect-to-arc
# NEXT_PUBLIC_RPC_URL_ARC_MAINNET="https://arc-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY" # Arc Mainnet (chain ID 5042)
# NEXT_PUBLIC_RPC_URL_ARC_TESTNET="https://arc-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY" # Arc Testnet (chain ID 5042002)

# RPC URLs for the unified USDC balance and ENS (optional - free public RPCs are used if unset)
# Uncomment and replace YOUR_ALCHEMY_API_KEY to use your own provider; placeholder values are ignored
# Mainnets
# NEXT_PUBLIC_RPC_URL_ETHEREUM_MAINNET="https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_POLYGON_MAINNET="https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_AVALANCHE_MAINNET="https://avax-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_BASE_MAINNET="https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# Testnets
# NEXT_PUBLIC_RPC_URL_ETHEREUM_SEPOLIA="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_POLYGON_AMOY="https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_AVALANCHE_FUJI="https://avax-fuji.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
# NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA="https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# USDC contract addresses are built in (lib/constants.ts)
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses

# ThirdWeb
# Get your Client ID from https://thirdweb.com/dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID="your_thirdweb_client_id"
# Get your Secret Key from https://thirdweb.com/dashboard (server-side only)
THIRDWEB_SECRET_KEY="your_thirdweb_secret_key"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Circle Gateway (for unified USDC balance)
# Get your API key from https://developers.circle.com
# The Gateway API (mainnet or testnet) follows the network selected in the UI
CIRCLE_GATEWAY_API_KEY="your_circle_gateway_api_key"
# Optional: force a custom Circle Gateway base URL for both networks
# CIRCLE_GATEWAY_BASE_URL="https://gateway-api.circle.com/v1"

# LI.FI (Phase 3 - for swap + bridge)
# LIFI_API_KEY="your_lifi_api_key" # If required by LI.FI SDK
